# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Sem essas variáveis, o Mindo funciona automaticamente em "modo local"
# (os dados ficam salvos no navegador, via localStorage).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional. Use apenas uma URL autorizada em Authentication > URL Configuration.
# Se ficar vazia, o link usa a "Site URL" configurada no Supabase.
NEXT_PUBLIC_SUPABASE_REDIRECT_URL=
